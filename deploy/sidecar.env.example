# ~/.config/claude-voice/sidecar.env  (chmod 600, never commit the real file)
CLAUDE_VOICE_HOME=/home/YOU/claude-voice
CLAUDE_VOICE_URL=https://relay.example.com/speak
CLAUDE_VOICE_TOKEN=
CLAUDE_VOICE_DEVICE=omarchy-notebook

# Use a TTS server with real streaming; some always answer audio/pcm 24 kHz s16le mono with stream=true
TTS_URL=https://tts.example.com/v1
TTS_MODEL=kokoro
TTS_VOICE=af_heart
TTS_FORMAT=pcm
TTS_PCM_RATE=24000
# Optional extra headers, e.g. reverse-proxy header auth in front of the TTS server
TTS_EXTRA_HEADERS="P-Access-Token-Id: ...; P-Access-Token: ..."
TTS_KEY=
