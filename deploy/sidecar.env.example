# ~/.config/claude-voice/sidecar.env  (chmod 600, never commit the real file)
CLAUDE_VOICE_HOME=/home/YOU/claude-voice
CLAUDE_VOICE_URL=https://voice.goetzken.dev
CLAUDE_VOICE_TOKEN=
CLAUDE_VOICE_DEVICE=omarchy-notebook

# vox: real streaming; with stream=true it always answers audio/pcm 24 kHz s16le mono
TTS_URL=https://vox.goetzken.dev/v1
TTS_MODEL=sopro
TTS_VOICE=timo_de
TTS_FORMAT=pcm
TTS_PCM_RATE=24000
# Pangolin header auth of vox.goetzken.dev (values: PANGOLIN_VOX_TOKEN_ID / PANGOLIN_VOX_TOKEN)
TTS_EXTRA_HEADERS="P-Access-Token-Id: ...; P-Access-Token: ..."
TTS_KEY=
