# Copy to .env (git-ignored). Generate: openssl rand -hex 32
CLAUDE_VOICE_TOKEN=change-me-to-a-long-random-token
# Rotation: CLAUDE_VOICE_TOKENS=new,old
# Bind address for the published port (default 127.0.0.1). Behind a reverse proxy on the same host use an internal bridge IP, never a public interface.
# RELAY_BIND=127.0.0.1
# Optional URL path prefix when the relay sits behind a shared reverse proxy that does not strip it
# (e.g. https://relay.example.com/speak; un-prefixed paths such as /healthz keep working). Also settable as [server] base_path in relay.toml.
# CLAUDE_VOICE_BASE_PATH=/speak
